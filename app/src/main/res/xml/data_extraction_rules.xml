<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml: settings only; the Keystore-held ADB identity is device-bound. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
